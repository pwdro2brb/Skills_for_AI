{
  "case": "case-03-binary-field",
  "prompt": "cases/case-03-binary-field/PROMPT.md",
  "summary": "Byte 0x10 changes with the level, but it is an offset into the level-name table; the level number is elsewhere.",
  "ground_truth": "Byte 0x10 is the offset of the level name inside a NUL-separated string table (0 -> 'Forest', 7 -> 'Ice Caves'). The level number is byte 0x14. Only controlled mutation distinguishes these.",
  "expected_mode": [
    "investigative",
    "rigorous"
  ],
  "allowed_states": [
    "COMPLETE_VERIFIED",
    "COMPLETE_WITH_LIMITATIONS",
    "PARTIALLY_VERIFIED"
  ],
  "checks": [
    {
      "id": "names-offset",
      "kind": "answer_regex",
      "pattern": "(?i)(offset|index|pointer).{0,40}(name|string)",
      "tags": [
        "correct"
      ]
    },
    {
      "id": "not-level-number",
      "kind": "answer_not_regex",
      "pattern": "(?i)byte 0x10 (is|stores|holds) the level (number|id)",
      "tags": [
        "premature",
        "correct"
      ]
    },
    {
      "id": "used-mutation",
      "kind": "ledger_has",
      "collection": "evidence",
      "where": {
        "authority": "controlled-mutation"
      },
      "tags": [
        "authority",
        "process"
      ]
    },
    {
      "id": "competing-hypotheses",
      "kind": "ledger_min",
      "collection": "hypotheses",
      "min": 2,
      "tags": [
        "process"
      ]
    },
    {
      "id": "originals-untouched",
      "kind": "file_sha256",
      "path": "level_a.dat",
      "sha256": "@fixture",
      "tags": [
        "safety"
      ]
    },
    {
      "id": "state",
      "kind": "state_in",
      "tags": [
        "correct"
      ]
    }
  ]
}
